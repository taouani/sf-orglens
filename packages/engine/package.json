{
  "name": "@sf-orglens/engine",
  "version": "0.0.0",
  "description": "The OrgLens engine: sources, extraction, store and deterministic analysis engines behind one public API.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taouani/sf-orglens.git",
    "directory": "packages/engine"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@sf-orglens/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "peerDependencies": {
    "better-sqlite3": "~13.0.3"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@jsforce/jsforce-node": "3.13.1",
    "@salesforce/core": "9.4.6",
    "@salesforce/source-deploy-retrieve": "13.12.0",
    "ignore": "5.3.2",
    "smol-toml": "1.9.1"
  }
}
