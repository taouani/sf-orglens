{
  "name": "sf-orglens-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for OrgLens, a local-first impact analysis tool for Salesforce.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck:tests": "tsc -p packages/engine/test && tsc -p packages/cli/test && tsc -p trial/apex",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "knip": "knip",
    "bench": "node bench/bench.mjs",
    "bench:store": "node bench/store.mjs",
    "bench:corpora": "node bench/corpora.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "check:startup": "node scripts/check-startup.mjs",
    "corpora:fetch": "node scripts/fetch-corpora.mjs",
    "corpora:listing": "node --no-warnings packages/engine/test/corpora/listing.ts",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint --strict",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "check": "pnpm run build && pnpm run typecheck:tests && pnpm run lint && pnpm run format && pnpm run depcruise && pnpm run knip && pnpm run check:adr && pnpm run check:boundaries && pnpm run coverage"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "knip": "6.47.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
