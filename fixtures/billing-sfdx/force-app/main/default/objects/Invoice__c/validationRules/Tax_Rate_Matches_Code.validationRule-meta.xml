<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tax_Rate_Matches_Code</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Tax_Code_Name__c)),
  Tax_Rate__c &lt;&gt; VLOOKUP(
    $ObjectType.Tax_Code__c.Fields.Rate__c,
    $ObjectType.Tax_Code__c.Fields.Name,
    Tax_Code_Name__c
  )
)</errorConditionFormula>
    <errorDisplayField>Tax_Rate__c</errorDisplayField>
    <errorMessage>The tax rate is not the rate of the tax code.</errorMessage>
</ValidationRule>
