<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Stamp_Tax_Code_Of_Invoice</fullName>
        <description>Writes a field of the invoice the line belongs to. The formula is about the line.</description>
        <field>Tax_Code_Name__c</field>
        <formula>IF(Is_Billable__c, &quot;STANDARD&quot;, &quot;EXEMPT&quot;)</formula>
        <name>Stamp Tax Code Of Invoice</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <targetObject>Invoice__c</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>Stamp_When_Billed</fullName>
        <actions>
            <name>Stamp_Tax_Code_Of_Invoice</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(ISPICKVAL(Status__c, &quot;Billed&quot;), Invoice__r.Amount__c &gt; 0)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
