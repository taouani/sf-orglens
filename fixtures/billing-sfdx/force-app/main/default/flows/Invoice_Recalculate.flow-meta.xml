    </assignments>
    <decisions>
        <name>Compare_Totals</name>
        <label>Compare Totals</label>
        <locationX>446</locationX>
        <locationY>542</locationY>
        <defaultConnector>
            <targetReference>Set_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Differs</defaultConnectorLabel>
        <rules>
            <name>Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>runningTotal</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>invoice.Lines_Total__c</elementReference>
                </rightValue>
            </conditions>
            <label>Matches</label>
        </rules>
        <rules>
            <name>Above_Credit_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>runningTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>invoice.Account__r.Credit_Limit__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Billing_Settings__c.Grace_Days__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_For_Approval</targetReference>
            </connector>
            <label>Above Credit Limit</label>
        </rules>
        <rules>
            <name>Late</name>
            <conditionLogic>1 AND (2 OR 3) AND 4 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>Is_Late</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>invoice.Due_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Organization.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Due_Date__c</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>invoice.Sub_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Overdue_Notice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Api.Session_ID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Late</targetReference>
            </connector>
            <label>Late</label>
        </rules>
    </decisions>
    <description>Adds up Line_Amount__c of the billable lines of an invoice and writes the sum to the invoice. Another flow starts it.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Late</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  {!invoice.Due_Date__c} + {!$Setup.Billing_Settings__c.Grace_Days__c} &lt; {!$Flow.CurrentDate},
  NOT({!$Permission.Approve_Large_Invoices}),
  {!$Profile.Name} &lt;&gt; &quot;System Administrator&quot;,
  NOT(ISBLANK({!$User.Email})),
  {!$Organization.Country} &lt;&gt; &quot;Paid_Date__c&quot;,
  {!$Label.Overdue_Notice} &lt;&gt; &quot;&quot;,
  LEN({!$Api.Session_ID}) &gt; 0
)</expression>
    </formulas>
    <formulas>
        <name>Line_Value</name>
        <dataType>Currency</dataType>
        <expression>{!Each_Line.Quantity__c} * {!Each_Line.Unit_Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Invoice Recalculate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice Recalculate</label>
    <loops>
        <name>Each_Line</name>
