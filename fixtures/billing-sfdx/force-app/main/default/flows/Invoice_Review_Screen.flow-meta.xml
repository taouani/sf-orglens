        <filters>
            <field>Rate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>Tax_Code__c</object>
        <outputAssignments>
            <assignToReference>varRate</assignToReference>
            <field>Rate__c</field>
        </outputAssignments>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Name</valueField>
