        <defaultConnector>
            <targetReference>Save_Invoice</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still Open</defaultConnectorLabel>
        <rules>
            <name>Nothing_To_Pay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varInvoice.Amount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Paid</targetReference>
            </connector>
            <label>Nothing To Pay</label>
        </rules>
        <rules>
            <name>Is_Credit_Note</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varInvoice.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit_Note</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Unbillable</targetReference>
            </connector>
            <label>Is Credit Note</label>
        </rules>
    </decisions>
    <description>A screen to review an invoice, to change its due date and tax code, and to add the late fee as a line.</description>
    <dynamicChoiceSets>
