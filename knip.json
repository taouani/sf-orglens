{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "layers.cjs", "tools/*.js"],
      "ignoreDependencies": ["better-sqlite3"]
    },
    "packages/engine": {
      "entry": ["test/**/*.test.ts", "test/live/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "trial/apex": {
      "entry": ["test/**/*.test.ts", "src/run-*.ts", "src/sample.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
